# Copy to .env and fill in. Never commit .env.

# Required. Database password for the user jbh_admin.
JBH_ADMIN_PASS=change-me

# Required. Base64, at least 32 bytes: openssl rand -base64 32
# Must be the same value in jbh-gateway.
JBH_JWT_SECRET=change-me-base64-secret

# Optional. Browser origins allowed by CORS, comma separated.
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100

# Optional. Google OAuth client IDs, comma separated. Empty turns Google sign-in off.
# GOOGLE_CLIENT_IDS=
